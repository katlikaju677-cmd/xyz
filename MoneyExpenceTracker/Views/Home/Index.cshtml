@model LedgerViewModel

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Recent activity</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Entries.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No entries yet. Add your first transaction.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var entry in Model.Entries)
                            {
                                <tr>
                                    <td>@entry.Date.ToString("MMM dd, yyyy")</td>
                                    <td>@entry.Description</td>
                                    <td>
                                        <span class="badge bg-@GetBadgeClass(entry.Type)">@entry.Type</span>
                                    </td>
                                    <td class="text-end">@entry.Amount.ToString("C")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Totals</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <span>Income</span>
                    <strong>@Model.TotalIncome.ToString("C")</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Expense</span>
                    <strong>@Model.TotalExpense.ToString("C")</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Saving</span>
                    <strong>@Model.TotalSaving.ToString("C")</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Balance</span>
                    <strong>@(Model.TotalIncome - Model.TotalExpense - Model.TotalSaving).ToString("C")</strong>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Add transaction</h5>
            </div>
            <div class="card-body">
                <form asp-action="Add" method="post">
                    <div class="mb-3">
                        <label asp-for="NewEntry.Description" class="form-label"></label>
                        <input asp-for="NewEntry.Description" class="form-control" />
                        <span asp-validation-for="NewEntry.Description" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewEntry.Amount" class="form-label"></label>
                        <input asp-for="NewEntry.Amount" class="form-control" />
                        <span asp-validation-for="NewEntry.Amount" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewEntry.Type" class="form-label"></label>
                        <select asp-for="NewEntry.Type" asp-items="Html.GetEnumSelectList<TransactionType>()" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewEntry.Date" class="form-label"></label>
                        <input asp-for="NewEntry.Date" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save entry</button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions
{
    private static string GetBadgeClass(TransactionType type)
    {
        return type switch
        {
            TransactionType.Income => "success",
            TransactionType.Expense => "danger",
            TransactionType.Saving => "info",
            _ => "secondary"
        };
    }
}
